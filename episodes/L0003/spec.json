  "sources": [
    {
      "title": "LuxAlgo Library: R-multiple framework",
      "url": "https://www.luxalgo.com/library/concept/r-multiple-framework/",
      "used_for": "R = entry-to-stop distance × position size, fixed at entry; R-multiple = result ÷ R; a full stop-out is −1R; a widened (moved) stop records a loss worse than −1R; Van Tharp popularised the convention in Trade Your Way to Financial Freedom (1998)"
    },
    {
      "title": "Van K. Tharp, Trade Your Way to Financial Freedom (McGraw-Hill, 1998; 2nd ed. 2007)",
      "url": "https://www.mheducation.com/highered/mhp/product/trade-your-way-financial-freedom.html",
      "used_for": "credit: the book that spread R-multiples (results as multiples of initial risk) among traders"
    },
    {
      "title": "FINRA: Stop orders, factors to consider during volatile markets",
      "url": "https://www.finra.org/investors/insights/stop-orders-factors-consider-during-volatile-markets",
      "used_for": "a stop becomes a market order when triggered and can fill well below the stop price in a fast market or gap, so a loss can exceed 1R"
    },
    {
      "title": "SEC Investor.gov: Investor Bulletin, stop, stop-limit and trailing stop orders",
      "url": "https://www.investor.gov/additional-resources/news-alerts/alerts-bulletins/investor-bulletin-stop-stop-limit-trailing-stop",
      "used_for": "cross-check: the stop price triggers the order; the execution price can differ significantly"
    },
    {
      "title": "sims/r_multiples.py (The Tape Lore, seed 3)",
      "url": "https://github.com/TheTapeLore/studio/blob/main/sims/r_multiples.py",
      "used_for": "the 20 simulated trades (+3.5R total, 8 winners, 12 losers at −1R), chosen as the first sequence within 1R of the median of 100,000 simulated sequences (+4R); $ conversions are +3.5 × $100 and +3.5 × $10,000"
    }
