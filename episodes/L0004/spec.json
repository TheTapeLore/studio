  "sources": [
    {
      "title": "Wikipedia: Jesse Livermore",
      "url": "https://en.wikipedia.org/wiki/Jesse_Livermore",
      "used_for": "1877-1940; 1891, age 14, board boy posting stock quotes ($5/week); 1892, first bucket-shop trade at 15; 1907 panic: $1 million in a single day; J.P. Morgan asked him to stop short selling; 1908: followed Teddy Price's advice to buy cotton and lost most of his 1907 profits; bankruptcy filings 1915 and 1934; 1929: approximately $100 million; his trades were based on what is now called technical analysis"
    },
    {
      "title": "Jesse L. Livermore, How to Trade in Stocks (Duell, Sloan & Pearce, 1940), first-edition record: Bauman Rare Books",
      "url": "https://www.baumanrarebooks.com/rare-books/livermore-jesse-l/how-to-trade-in-stocks/104516.aspx",
      "used_for": "his own words, paraphrased: ch. V the pivotal point (wait for it, then sit tight); ch. VI 'The Million Dollar Blunder' (bought cotton before the pivotal point five times in six weeks, lost about $200,000); ch. II and IV never average losses, add only at higher prices; ch. IV he lost every cent he put into ventures outside Wall Street (Florida real estate, oil wells, aircraft) and drew out cash after successful deals; tips and over-trading as the speculator's enemies"
    },
    {
      "title": "Edwin Lefèvre, Reminiscences of a Stock Operator (1923), Project Gutenberg #60979",
      "url": "https://www.gutenberg.org/ebooks/60979",
      "used_for": "the semi-fictional account of his career (narrator Larry Livingston): kept buying cotton on a friend's analysis as it fell and lost nearly everything he had made; in the 1907 panic stopped selling when asked and bought for the long side"
    },
    {
      "title": "Wikipedia: Reminiscences of a Stock Operator",
      "url": "https://en.wikipedia.org/wiki/Reminiscences_of_a_Stock_Operator",
      "used_for": "the book remains in print; Wiley annotated edition (2009) with a foreword by Paul Tudor Jones; Alan Greenspan called it 'a font of investing wisdom'"
    }
  ],
